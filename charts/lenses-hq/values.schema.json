                    "properties": {
                        "host": {
                            "type": "string",
                            "default": null,
                            "title": "The host Schema",
                            "examples": [
                                "10.0.0.1"
                            ]
                        },
                        "port": {
                            "type": "integer",
                            "default": null,
                            "title": "The port Schema",
                            "examples": [
                                5432
                            ]
                        },
                        "username": {
                            "type": "string",
                            "default": null,
                            "title": "The username Schema",
                            "examples": [
                                "lenseshq"
                            ]
                        },
                        "database": {
                            "type": "string",
                            "default": null,
                            "title": "The database Schema",
                            "examples": [
                                "lensesDbName"
                            ]
                        },
                        "passwordSecret": {
                            "type": "object",
                            "default": {},
                            "title": "The passwordSecret Schema",
                            "required": [
                                "type",
                                "name",
                                "key"
                            ],
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "default": "precreated",
                                    "title": "The type Schema",
                                    "pattern": "^(precreated|createNew|externalSecret)$",
                                    "enum": ["createNew", "precreated", "externalSecret"],
                                    "examples": [
                                        "precreated",
                                        "createNew",
                                        "externalSecret"
                                    ]
                                }
                            },
                            "externalSecret": {
                                "type": "object",
                                "default": {},
                                "title": "Schema for externalSecret reference in case of externalSecret usage",
                                "required": [
                                    "secretStoreRef"
                                ],
                                "properties": {
                                    "secretStoreRef":{
                                        "type":"object",
                                        "default": {},
                                        "title": "Schema for externalSecret reference in case of externalSecret usage",
                                        "required":[
                                            "clusterSecretStore"
                                        ],
                                        "properties": {
                                            "clusterSecretStore": {
                                                "type": "object",
                                                "default": {},
                                                "title": "Schema for externalSecret reference in case of externalSecret usage",
                                                "required": [
                                                    "name"
                                                ],
                                                "properties": {
                                                    "name": {
                                                        "type": ["string", "null"],
                                                        "default": "",
                                                        "examples": [
                                                            "secretName"
                                                        ]
                                                    }
                                                }
                                            }
                                        }
                                    }
                                },
                                "key": {
                                    "type": "string",
                                    "default": null,
                                    "title": "The key Schema",
                                    "examples": [
                                        "secretKeyName",
                                        "/hello-service/password"
                                    ]
                                },
                                "password": {
                                    "type": ["string", "null"],
                                    "default": null,
                                    "title": "Password for createNew type",
                                    "examples": [
                                        "abc123def"
                                    ]
                                }
                            },
                            "examples": [{
                                "type": "precreated",
                                "name": null,
                                "key": null,
                                "password": null
                            }]
                        }
                    },
                    "examples": [{
                        "host": null,
                        "port": null,
                        "username": null,
                        "database": null,
                        "passwordSecret": {
                            "type": "precreated",
                            "name": null,
