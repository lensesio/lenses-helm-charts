                                "organisationName": {
                                    "type": "string",
                                    "default": "",
                                    "title": "The organisationName Schema",
                                    "examples": [
                                        "my-company"
                                    ]
                                },
                                "baseUrl": {
                                    "type": "string",
                                    "default": "",
                                    "title": "The baseUrl Schema",
                                    "examples": [
                                        "https://saml.example.com/api/saml/sso"
                                    ]
                                },
                                "entityId": {
                                    "type": "string",
                                    "default": "",
                                    "title": "The entityId Schema",
                                    "examples": [
                                        "https://saml.example.com/entityid"
                                    ]
                                },
                                "metadata": {
                                    "type": "object",
                                    "default": "",
                                    "title": "The metadata Schema",
                                    "examples": [
                                        ""
                                    ],
                                    "properties": {
                                        "useConfigMap": {
                                            "type": "boolean",
                                            "default": "false",
                                            "title": "Read metadata xml file from ConfigMap Schema",
                                            "examples": [
                                                true,
                                                false
                                            ]
                                        },
                                        "configMapName": {
                                            "type": "string",
                                            "default": "",
                                            "title": "ConfigMap name where Saml metadata is stored Schema",
                                            "examples": [
                                                "metadata-configmap"
                                            ]
                                        },
                                        "confiMapKey": {
                                            "type": "string",
                                            "default": "metadata.xml",
                                            "title": "ConfigMap key used to refernce configmap metadata information.",
                                            "examples": [
                                                "metadata.xml"
                                            ]
                                        },
                                        "stringData": {
                                            "type": "string",
                                            "default": "",
                                            "title": " Contains the IdP issued XML metadata blob.",
                                            "examples": [
                                                "<?xml version= ... (big blob of xml) </md:EntityDescriptor>"
                                            ]
                                        }
                                    }
                                },
                                "userCreationMode": {
                                    "type": "string",
                                    "default": "",
                                    "pattern": "^(sso|manual)$",
                                    "title": "The userCreationMode Schema",
                                    "examples": [
                                        "sso",
                                        "manual"
                                    ]
                                },
                                "usersGroupMembershipManagementMode": {
                                    "type": "string",
                                    "default": "",
                                    "pattern": "^(sso|manual)$",
                                    "title": "The usersGroupMembershipManagementMode Schema",
                                    "examples": [
                                        "sso",
                                        "manual"
                                    ]
                                }
                            },
                            "examples": [{
                                "organisationName": "my-company",
                                "baseUrl": "",
                                "entityId": "",
                                "metadata": "",
                                "userCreationMode": "",
                                "usersGroupMembershipManagementMode": ""
                            }]
                        }
                    },
                    "examples": [{
                        "address": ":8080",
                        "accessControlAllowOrigin": ["https://example.io","http://example.io"],
                        "saml": {
                            "organisationName": "my-company",
                            "baseUrl": "",
                            "entityId": "",
                            "metadata": "",
                            "userCreationMode": "",
                            "usersGroupMembershipManagementMode": ""
