                "monitoring": {
                    "type": "object",
                    "default": {},
                    "title": "The monitoring Schema",
                    "required": [
                        "port"
                    ],
                    "properties": {
                        "port": {
                            "type": "integer",
                            "default": 0,
                            "title": "The port Schema",
                            "examples": [
